{
  "name": "orchidiary",
  "private": true,
  "version": "0.1.0",
  "description": "Guia de cultivo e diário de orquídeas — mobile first, PWA.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @orchidiary/api --filter @orchidiary/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "db:generate": "pnpm --filter @orchidiary/api db:generate",
    "db:migrate": "pnpm --filter @orchidiary/api db:migrate",
    "db:seed": "pnpm --filter @orchidiary/api db:seed",
    "db:seed:demo": "pnpm --filter @orchidiary/api db:seed:demo"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
