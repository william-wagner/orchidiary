# Copie para .env e ajuste.

# Banco (docker compose sobe um Postgres com estes valores)
DATABASE_URL=postgres://orchidiary:orchidiary@localhost:5432/orchidiary

# API
API_PORT=8787
# Origem do app web (para CORS). Com Tailscale, use o endereço https da máquina.
WEB_ORIGIN=http://localhost:5173
# Fuso usado para fechar os "dias" do diário e agendar as rotinas
APP_TIMEZONE=America/Sao_Paulo
# Onde as fotos ficam no disco
STORAGE_DIR=./data/photos

# Usuário master criado pelo seed (pnpm db:seed)
MASTER_EMAIL=voce@exemplo.com
MASTER_PASSWORD=troque-esta-senha
MASTER_NAME=William

# Chave para criptografar segredos de integrações (Telegram, Google Drive) no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# Distância (metros) a partir da qual uma foto é considerada "fora do local da ficha"
LOCATION_MISMATCH_METERS=300

# Logs: arquivo diário em LOG_DIR (stdout também) + tabela app_logs (warn/error e auditoria)
LOG_LEVEL=info
LOG_DIR=./data/logs
LOG_FILE_RETENTION_DAYS=14
LOG_DB_RETENTION_DAYS=90

# development | production (em produção a API serve o app web e usa cookie seguro)
NODE_ENV=development
