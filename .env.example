# Copie para .env e ajuste.

# Banco (docker compose sobe um Postgres com esta senha)
# No servidor, use uma senha longa e aleatória. Ela só vale na criação do volume:
# num banco que já existe, mantenha a senha com que ele foi criado.
POSTGRES_PASSWORD=orchidiary
DATABASE_URL=postgres://orchidiary:orchidiary@localhost:5440/orchidiary

# Domínio público (o Caddy do docker compose emite o certificado HTTPS para ele)
APP_DOMAIN=localhost

# API
API_PORT=8787
# Origem do app web (para CORS). Em produção, https://<APP_DOMAIN>.
WEB_ORIGIN=http://localhost:5173
# Fuso usado para fechar os "dias" do diário e agendar as rotinas
APP_TIMEZONE=America/Sao_Paulo
# Onde as fotos ficam no disco
STORAGE_DIR=./data/photos

# Usuário master criado pelo seed (pnpm db:seed). Em produção, senha longa e única.
MASTER_EMAIL=voce@exemplo.com
MASTER_PASSWORD=troque-esta-senha
MASTER_NAME=William

# Chave para criptografar segredos de integrações (Telegram, Google Drive) no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde num gerenciador de senhas: sem ela, as integrações salvas ficam ilegíveis.
# Ao migrar o banco para outro servidor, leve a MESMA chave.
SECRETS_KEY=

# Distância (metros) a partir da qual uma foto é considerada "fora do local da ficha"
LOCATION_MISMATCH_METERS=300

# Logs: arquivo diário em LOG_DIR (stdout também) + tabela app_logs (warn/error e auditoria)
LOG_LEVEL=info
LOG_DIR=./data/logs
LOG_FILE_RETENTION_DAYS=14
LOG_DB_RETENTION_DAYS=90
# Chamadas a serviços externos (tabela external_calls): dias de retenção das que deram certo e das com falha
EXTERNAL_CALLS_RETENTION_DAYS=30
EXTERNAL_CALLS_ERROR_RETENTION_DAYS=90

# development | production (em produção a API serve o app web e usa cookie seguro)
NODE_ENV=development
# true quando a API está atrás de um proxy (o docker compose já liga isso para o app)
TRUST_PROXY=false
